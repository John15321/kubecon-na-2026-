variant: flatcar
version: 1.0.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - __SSH_PUBLIC_KEY__
storage:
  files:
    # Tells Flatcar which NVIDIA driver sysext to fetch and merge at boot.
    # Flatcar's own nvidia.service handles the download.
    - path: /etc/flatcar/enabled-sysext.conf
      mode: 0644
      contents:
        inline: nvidia-drivers-580-open
    # The Kubernetes sysext image: kubeadm, kubelet, and kubectl.
    - path: /opt/extensions/kubernetes/kubernetes-v1.37.1-x86-64.raw
      mode: 0644
      contents:
        source: https://extensions.flatcar.org/extensions/kubernetes-v1.37.1-x86-64.raw
    # nvidia-runtime: the container-runtime integration, separate from the
    # driver. Pinned to v1.19.1. v1.17.9 breaks GPU pods at container
    # creation, so do not use it.
    - path: /opt/extensions/nvidia-runtime/nvidia-runtime-v1.19.1-x86-64.raw
      mode: 0644
      contents:
        source: https://extensions.flatcar.org/extensions/nvidia-runtime-v1.19.1-x86-64.raw
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: flatcar-gpu-demo
    # Staged on disk so folder 06's `kubectl apply -f vllm-demo.yaml` needs
    # no copy step. Keep this in sync by hand with
    # 06-vllm-inference-on-flatcar/vllm-demo.yaml.
    - path: /home/core/vllm-demo.yaml
      mode: 0644
      contents:
        inline: |
          apiVersion: apps/v1
          kind: Deployment
          metadata:
            name: vllm-demo
          spec:
            replicas: 1
            selector:
              matchLabels:
                app: vllm-demo
            template:
              metadata:
                labels:
                  app: vllm-demo
              spec:
                containers:
                  - name: vllm
                    image: vllm/vllm-openai:latest
                    args:
                      - "--model"
                      - "Qwen/Qwen2.5-0.5B-Instruct"
                      - "--port"
                      - "8000"
                    ports:
                      - containerPort: 8000
                    resources:
                      limits:
                        nvidia.com/gpu: "1"
                    readinessProbe:
                      httpGet:
                        path: /health
                        port: 8000
                      initialDelaySeconds: 20
                      periodSeconds: 5
                    startupProbe:
                      httpGet:
                        path: /health
                        port: 8000
                      failureThreshold: 60
                      periodSeconds: 5
          ---
          apiVersion: v1
          kind: Service
          metadata:
            name: vllm-demo
          spec:
            selector:
              app: vllm-demo
            ports:
              - port: 8000
                targetPort: 8000
    # Staged on disk so folder 08's `kubectl apply -f triton-demo.yaml`
    # needs no copy step. One apply brings up the Triton server and the
    # client Job. Keep this in sync by hand with
    # 08-triton-inference-on-flatcar/triton-demo.yaml.
    - path: /home/core/triton-demo.yaml
      mode: 0644
      contents:
        inline: |
          apiVersion: v1
          kind: ConfigMap
          metadata:
            name: triton-model-fetch
          data:
            fetch.sh: |
              #!/bin/sh
              set -e
              # NVIDIA's Triton example model (ONNX DenseNet, image classification).
              mkdir -p /models/densenet_onnx/1
              cd /models/densenet_onnx
              wget -q https://raw.githubusercontent.com/triton-inference-server/server/main/docs/examples/model_repository/densenet_onnx/config.pbtxt -O config.pbtxt
              wget -q https://raw.githubusercontent.com/triton-inference-server/server/main/docs/examples/model_repository/densenet_onnx/densenet_labels.txt -O densenet_labels.txt
              wget -q -O 1/model.onnx \
                "https://media.githubusercontent.com/media/onnx/models/main/validated/vision/classification/densenet-121/model/densenet-9.onnx"
          ---
          apiVersion: apps/v1
          kind: Deployment
          metadata:
            name: triton-demo
          spec:
            replicas: 1
            selector:
              matchLabels:
                app: triton-demo
            template:
              metadata:
                labels:
                  app: triton-demo
              spec:
                initContainers:
                  - name: fetch-model
                    image: busybox:1.36
                    command: ["sh", "/scripts/fetch.sh"]
                    volumeMounts:
                      - name: scripts
                        mountPath: /scripts
                      - name: models
                        mountPath: /models
                containers:
                  - name: triton
                    # Pin an exact tag before recording.
                    image: nvcr.io/nvidia/tritonserver:24.08-py3
                    args: ["tritonserver", "--model-repository=/models"]
                    ports:
                      - containerPort: 8000   # HTTP
                      - containerPort: 8001   # gRPC
                      - containerPort: 8002   # metrics
                    resources:
                      limits:
                        nvidia.com/gpu: "1"
                    volumeMounts:
                      - name: models
                        mountPath: /models
                    readinessProbe:
                      httpGet:
                        path: /v2/health/ready
                        port: 8000
                      initialDelaySeconds: 15
                      periodSeconds: 5
                volumes:
                  - name: scripts
                    configMap:
                      name: triton-model-fetch
                      defaultMode: 0755
                  - name: models
                    emptyDir: {}
          ---
          apiVersion: v1
          kind: Service
          metadata:
            name: triton-demo
          spec:
            selector:
              app: triton-demo
            ports:
              - name: http
                port: 8000
                targetPort: 8000
          ---
          # The client. Triton wants a raw tensor payload, not a plain curl, so the
          # client is a small program. It runs in-cluster and reaches the server by
          # its Service name triton-demo:8000, which resolves from inside a pod. This
          # needs no port-forward, and Flatcar's host has no python anyway.
          apiVersion: v1
          kind: ConfigMap
          metadata:
            name: triton-client-script
          data:
            classify.py: |
              #!/usr/bin/env python3
              """Minimal Triton HTTP client for the densenet_onnx demo model.

              Reaches the Triton server by its in-cluster Service DNS name. Downloads
              a test image, preprocesses it to DenseNet's 224x224x3 input, sends it,
              prints the top prediction.
              """
              import sys
              import numpy as np
              from io import BytesIO
              from urllib.request import urlopen
              from PIL import Image
              import tritonclient.http as httpclient

              def preprocess(image_bytes):
                  img = Image.open(BytesIO(image_bytes)).convert("RGB").resize((224, 224))
                  arr = np.asarray(img, dtype=np.float32) / 255.0
                  mean = np.array([0.485, 0.456, 0.406], dtype=np.float32)
                  std = np.array([0.229, 0.224, 0.225], dtype=np.float32)
                  arr = (arr - mean) / std
                  return arr.transpose(2, 0, 1)  # CHW; model has max_batch_size=0, no batch dim

              def main():
                  image_url = sys.argv[1] if len(sys.argv) > 1 else \
                      "https://raw.githubusercontent.com/pytorch/hub/master/images/dog.jpg"
                  triton_addr = sys.argv[2] if len(sys.argv) > 2 else "triton-demo:8000"

                  image_bytes = urlopen(image_url).read()
                  input_tensor = preprocess(image_bytes)

                  client = httpclient.InferenceServerClient(url=triton_addr)
                  infer_input = httpclient.InferInput("data_0", input_tensor.shape, "FP32")
                  infer_input.set_data_from_numpy(input_tensor)
                  result = client.infer(model_name="densenet_onnx", inputs=[infer_input])

                  output = np.squeeze(result.as_numpy("fc6_1"))  # (1000,) regardless of trailing dims
                  top_idx = int(np.argmax(output))
                  print(f"Predicted class index: {top_idx} (confidence score: {output[top_idx]:.3f})")
                  print("Cross-reference against densenet_labels.txt in the model repo for the class name.")

              if __name__ == "__main__":
                  main()
          ---
          apiVersion: batch/v1
          kind: Job
          metadata:
            name: triton-classify
          spec:
            backoffLimit: 1
            template:
              spec:
                restartPolicy: Never
                containers:
                  - name: client
                    image: python:3.11-slim
                    command: ["sh", "-c"]
                    # pip install adds ~30s and prints pip noise. For a clean
                    # recording, bake the deps into an image or use the Triton SDK
                    # image. The retry loop lets this Job start with the server in one
                    # apply: it retries until the server answers.
                    args:
                      - |
                        pip install --quiet --no-cache-dir "tritonclient[http]" pillow numpy
                        echo "waiting for triton-demo to answer..."
                        for i in $(seq 1 60); do
                          if python /app/classify.py \
                              https://raw.githubusercontent.com/pytorch/hub/master/images/dog.jpg \
                              triton-demo:8000; then
                            exit 0
                          fi
                          echo "  not ready yet (attempt $i), retrying in 5s..."
                          sleep 5
                        done
                        echo "triton-demo did not become ready in time" >&2
                        exit 1
                    volumeMounts:
                      - name: script
                        mountPath: /app
                volumes:
                  - name: script
                    configMap:
                      name: triton-client-script
    # Helm, fetched here so it is present at boot (Flatcar has no package
    # manager). The GPU Operator install itself stays a live step. Pinned
    # to v3.22.1; the GPU Operator chart is not verified against Helm v4.
    - path: /opt/helm/helm-v3.22.1-linux-amd64.tar.gz
      mode: 0644
      contents:
        source: https://get.helm.sh/helm-v3.22.1-linux-amd64.tar.gz
    # Exports FLANNEL_URL so the CNI step reads as `kubectl apply -f
    # ${FLANNEL_URL}`. Pinned to v0.28.10 so the command cannot change
    # between rehearsal and recording.
    - path: /etc/profile.d/demo-vars.sh
      mode: 0644
      contents:
        inline: |
          export FLANNEL_URL="https://github.com/flannel-io/flannel/releases/download/v0.28.10/kube-flannel.yml"
    # Puts /opt/bin on PATH for login shells, so `helm` is found with no
    # manual export.
    - path: /etc/profile.d/opt-bin-path.sh
      mode: 0644
      contents:
        inline: |
          export PATH="/opt/bin:$PATH"
  links:
    - path: /etc/extensions/kubernetes.raw
      target: /opt/extensions/kubernetes/kubernetes-v1.37.1-x86-64.raw
      hard: false
    - path: /etc/extensions/nvidia-runtime.raw
      target: /opt/extensions/nvidia-runtime/nvidia-runtime-v1.19.1-x86-64.raw
      hard: false
systemd:
  units:
    - name: systemd-sysext.service
      enabled: true
    # Runs kubeadm init once, same as folder 03. The --kubernetes-version
    # pin matters: v1.37.2 crashes on start, v1.37.1 works.
    - name: kubeadm.service
      enabled: true
      contents: |
        [Unit]
        Description=kubeadm init (single-node GPU demo control plane)
        Requires=containerd.service
        After=containerd.service network-online.target systemd-sysext.service
        Wants=network-online.target
        ConditionPathExists=!/etc/kubernetes/kubelet.conf
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStartPre=/usr/bin/kubeadm init --kubernetes-version=v1.37.1 --pod-network-cidr=10.244.0.0/16 --cri-socket=unix:///run/containerd/containerd.sock
        ExecStartPre=/usr/bin/mkdir -p /home/core/.kube
        ExecStartPre=/usr/bin/cp /etc/kubernetes/admin.conf /home/core/.kube/config
        ExecStart=/usr/bin/chown -R core:core /home/core/.kube
        [Install]
        WantedBy=multi-user.target
    # Extracts the Helm tarball and installs the binary into /opt/bin. The
    # tarball is already on disk, so this needs no network.
    - name: helm-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install Helm into /opt/bin (bootstrap only -- GPU Operator install stays a live, narrated step)
        ConditionPathExists=!/opt/bin/helm
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStartPre=/usr/bin/mkdir -p /opt/bin
        ExecStartPre=/usr/bin/tar -xzf /opt/helm/helm-v3.22.1-linux-amd64.tar.gz -C /opt/helm
        ExecStartPre=/usr/bin/cp /opt/helm/linux-amd64/helm /opt/bin/helm
        ExecStart=/usr/bin/chmod +x /opt/bin/helm
        [Install]
        WantedBy=multi-user.target
