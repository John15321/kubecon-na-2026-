[0.512641, "o", "\u001b[27;81H   \u001b[2;26r\u001b[26;1H\n\u001b[K\u001b[4Ca test image, preprocesses it to DenseNet's 224x224x3 input, sends it,\u001b[27;91H90,5\u001b[10X\u001b[10C47%\u001b[K\u001b[1;28r\u001b[21;5H"]
[0.497869, "o", "\u001b[2;26r\u001b[26;1H\n\u001b[K\u001b[4Cprints the top prediction.\u001b[27;81H   \u001b[7C91,5\u001b[10X\u001b[10C48%\u001b[K\u001b[26;1H\n\u001b[K\u001b[4C\"\"\"\u001b[27;91H92,5\u001b[10X\u001b[10C48%\u001b[K\u001b[1;28r\u001b[21;5H"]
