[6.514938, "o", "\u001b[2;93H\u001b[38;5;234m\u001b[48;5;105m06:20:58 [99/99]\u001b[2;1H\u001b[39m\u001b[49mTargeting\u001b[Cfolder 04's \u001b[Cnst\u001b[Cnc\u001b[C (i-05206d091e7b05809,\u001b[C3.94.96.58).            \r\nWaiting for\u001b[Csshd on :22...\r\n              \u001b[2C           \r\nReady. SSH in with:     \r\n  ssh -i ../04-nvidia-driver-on-fla\u001b[Ccar-\u001b[Cws/ssh/demo_ed25519 -o StrictHostKeyChecking=no -o UserKnownHostsFi\u001b[7;1Hle=/dev/\u001b[Cull core@3.94.96.58\u001b[C    \r\n                  \u001b[9C                           \r\nThis folder assumes\u001b[Cfolder\u001b[C04's cluster is already Ready with the GPU\r\nOperator installed.\u001b[CSee\u001b[Cthis folder's README.md for the exact commands.\r\n   \u001b[C      \u001b[17C                           \r\nPresentation mode:\u001b[CON                                 \r\n  - au\u001b[Cosuggestions\u001b[Coff                                            \u001b[C         \u001b[C   \u001b[C                          \u001b[14;1H  - syntax highlighting set to a high-con\u001b[Crast palette                                  \r\n  - prompt path shows only the last 2 folders\r\n  - ghostty theme\u001b[Cset\u001b[Cto\u001b[Cpresentation (Ctrl+Shift+R\u001b[Cin Gho\u001b[Ctty to apply)\r\n  \u001b[38;5;31m  demos/08-triton-inference-on-flatcar \u001b[39mon\u001b[C\u001b[38;5;76m \u001b(B\u001b[m\u001b[38;5;178m \u001b(B\u001b[m\u001b[38;5;76m main = *1 \u001b(B\u001b[m\u001b[38;5;178m!17 \u001b(B\u001b[m\u001b[38;5;39m?8\u001b[39m                               \u001b[38;5;74mtask !1/4\r\n\u001b(B\u001b[m\u001b[38;5;76m❯\u001b[39m \u001b[34m\u001b[1mssh\u001b(B\u001b[m -i \u001b[30m\u001b[4m../04-nvidia-driver-on-flatcar-aws/ssh/demo_ed25519\u001b(B\u001b[m -o \u001b[30mStrictHostKeyChecking=no\u001b[39m -o \u001b[30mUserKnownHostsFi\u001b[19;1Hle=/dev/null\u001b[39m \u001b[30mcore@3.94.96.58\u001b[39m                           \u001b[C       \u001b[C     \u001b[C   \u001b[C        \u001b[C                         \u001b[20;1H                         \u001b[C       \u001b[C      \u001b[C  \u001b[C              \u001b[C                                                 \u001b[21;1H\u001b[32m\u001b[1mcore@flatcar-gpu-demo\u001b[34m ~ $\u001b(B\u001b[m          \u001b[C    \u001b[C       \u001b[C                                                           \u001b[22;1H\u001b[32m\u001b[1mcore@flatcar-gpu-demo\u001b[34m ~ $\u001b(B\u001b[m ls                      \r\ngpu-test.yaml  triton-demo.yaml  vllm-demo.yaml\r\n\u001b[32m\u001b[1mcore@flatcar-gpu-demo\u001b[34m ~ $\u001b[C\u001b(B\u001b[mcat triton-demo.yaml\u001b[C|\u001b[Cless            \u001b[3C                                        \u001b[25;1H\u001b[32m\u001b[1mcore@flatcar-gpu-demo\u001b[34m ~ $\u001b[C\u001b(B\u001b[mkubectl apply -f triton-demo.yaml\u001b[C             \r\nconfigmap/triton-model\u001b[Cfetch\u001b[Ccreated                      \u001b[10C                                        \u001b[27;1Hdeployment.apps/triton-demo created \u001b[2;1H"]
