[0.496087, "o", "\u001b[2;26r\u001b[26;1H\n\u001b[K# The client. Triton wants a raw tensor payload, not a plain curl, so the\u001b[27;81H   \u001b[7C76,5\u001b[10X\u001b[10C38%\u001b[K\u001b[26;1H\n\u001b[K# client is a small program. It runs in-cluster and reaches the server by\u001b[27;91H77,5\u001b[10X\u001b[10C38%\u001b[K\u001b[1;28r\u001b[21;5H"]
