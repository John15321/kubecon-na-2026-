[0.000361, "o", "\u001b[?25l\u001b[2;4H\u001b[1K\u001b[Cdef main():\u001b[K\u001b[3;8H\u001b[1K\u001b[Cimage_url = sys.argv[1] if len(sys.argv) > 1 else \\\u001b[K\u001b[4;12H\u001b[1K\u001b[C\"https://raw.githubusercontent.com/pytorch/hub/master/images/dog.jpg\"\u001b[K\u001b[5;8H\u001b[1K\u001b[Ctriton_addr = sys.argv[2] if len(sys.argv) > 2 else \"triton-demo:8000\"\u001b[K\r\n\u001b[K\u001b[7;8H\u001b[1K\u001b[Cimage_bytes = urlopen(image_url).read()\u001b[K\u001b[8;8H\u001b[1K\u001b[Cinput_tensor = preprocess(image_bytes)\u001b[K\r\n\u001b[K\u001b[10;8H\u001b[1K\u001b[Cclient = httpclient.InferenceServerClient(url=triton_addr)\u001b[K\u001b[11;8H\u001b[1K\u001b[Cinfer_input = httpclient.InferInput(\"data_0\", input_tensor.shape, \"FP32\")\u001b[K\u001b[12;8H\u001b[1K\u001b[Cinfer_input.set_data_from_numpy(input_tensor)\u001b[K\u001b[13;8H\u001b[1K\u001b[Cresult = client.infer(model_name=\"densenet_onnx\", inputs=[infer_input])\u001b[K\r\n\u001b[K\u001b[15;8H\u001b[1K\u001b[Coutput = np.squeeze(result.as_numpy(\"fc6_1\"))  # (1000,) regardless of trailing dims\u001b[K\u001b[16;8H\u001b[1K\u001b[Ctop_idx = int(np.argmax(output))\u001b[K\u001b[17;8H\u001b[1K\u001b[Cprint(f\"Predicted class index: {top_idx} (confidence score: {output[top_idx]:.3f})\")\u001b[K\u001b[18;8H\u001b[1K\u001b[Cprint(\"Cross-reference against densenet_labels.txt in the model repo for the class name.\")\u001b[K\r\n\u001b[K\u001b[20;4H\u001b[1K\u001b[Cif __name__ == \"__main__\":\u001b[K\u001b[21;8H\u001b[1K\u001b[Cmain()\u001b[K\r\n---\u001b[K\r\napiVersion: batch/v1\u001b[K\r\nkind: Job\u001b[K\r\nmetadata:\u001b[K\u001b[26;2H\u001b[1K\u001b[Cname: triton-classify\u001b[K\u001b[27;80H\u001b[1K\u001b[C   \u001b[7X\u001b[7C132,9\u001b[9X\u001b[9C76%\u001b[K\u001b[38;5;207m\u001b[1;3H08-triton-inference-on-flatcar──────────────────────────────────────────────────────────────────────────\u001b[H──\u001b[104C──\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[21;9H"]
