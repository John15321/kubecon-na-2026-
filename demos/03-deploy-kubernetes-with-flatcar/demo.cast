[0.006483, "o", "\u001b[?25l\u001b[AapiVersion: v1\u001b[K\r\nkind: ConfigMap\u001b[K\r\nmetadata:\u001b[K\r\n  name: flatcar-demo-app-code\u001b[K\r\ndata:\u001b[K\r\n  server.py: |\u001b[K\r\n    import os\u001b[K\r\n    import socket\u001b[K\r\n    from datetime import datetime, timezone\u001b[K\r\n    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\u001b[K\r\n\u001b[K\r\n    count = 0\u001b[K\r\n\u001b[K\r\n    class Handler(BaseHTTPRequestHandler):\u001b[K\r\n        def do_GET(self):\u001b[K\r\n            global count\u001b[K\r\n            count += 1\u001b[K\r\n            body = f\"\"\"<!DOCTYPE html>\u001b[K\r\n    <html>\u001b[K\r\n    <head><title>Hello from Flatcar</title></head>\u001b[K\r\n    <body style=\"font-family: sans-serif; text-align: center; margin-top: 8%;\">\u001b[K\r\n      <h1>Running on a Flatcar-powered Kubernetes node</h1>\u001b[K\r\n      <p>Pod name: <b>{os.environ.get('POD_NAME', 'unknown')}</b></p>\u001b[K\r\n      <p>Pod IP: <b>{os.environ.get('POD_IP', 'unknown')}</b></p>\u001b[K\r\n      <p>Node: <b>{os.environ.get('NODE_NAME', 'unknown')}</b></p>\u001b[K\r\n      <p>Requests served by this pod: <b>{count}</b></p>\u001b[K\r\n      <p>Server time: {datetime.now(timezone.utc).isoformat()}</p>\u001b[K\r\n    </body>\u001b[K\r\n    </html>\"\"\"\u001b[K\r\n            self.send_response(200)\u001b[K\r\n            self.send_header(\"Content-Type\", \"text/html\")\u001b[K\r\n            self.end_headers()\u001b[K\r\n            self.wfile.write(body.encode())\u001b[K\r\n\u001b[K\r\n        def log_message(self, fmt, *args):\u001b[K\r\n            pass\u001b[K\r\n\u001b[K\u001b[7m\r\nlines 1-37\u001b(B\u001b[m\u001b[K\u001b[?12l\u001b[?25h"]
[1.299886, "o", "\u001b[10;47r\u001b[47;1H\n\u001b[A    ThreadingHTTPServer((\"0.0.0.0\", 8080), Handler).serve_forever()\u001b[K\r\n\u001b[7mlines 2-38\u001b(B\u001b[m\u001b[K\u001b[1;48r\u001b[47;11H"]
