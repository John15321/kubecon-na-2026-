variant: flatcar
version: 1.0.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - __SSH_PUBLIC_KEY__
storage:
  files:
    # Pinned to the 570 branch, not 580: this instance boots Flatcar alpha
    # 4865.0.0, which publishes both nvidia-drivers-570-open and
    # nvidia-drivers-580-open for this same build/kernel. The demo swaps
    # this file to 580-open in place (same OS build, no update_engine) and
    # reboots to watch the driver flip.
    - path: /etc/flatcar/enabled-sysext.conf
      mode: 0644
      contents:
        inline: nvidia-drivers-570-open
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: flatcar-nvidia-upgrade-demo
systemd:
  units:
    - name: systemd-sysext.service
      enabled: true
