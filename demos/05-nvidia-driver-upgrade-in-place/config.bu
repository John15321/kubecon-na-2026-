variant: flatcar
version: 1.0.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - __SSH_PUBLIC_KEY__
storage:
  files:
    # The 570 branch, not 580: this instance boots Flatcar alpha 4820.0.1,
    # the last build before branch 580 was added. The demo updates this
    # instance to the current build and watches the driver flip to 580.
    - path: /etc/flatcar/enabled-sysext.conf
      mode: 0644
      contents:
        inline: nvidia-drivers-570-open
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: flatcar-nvidia-upgrade-demo
systemd:
  units:
    - name: systemd-sysext.service
      enabled: true
