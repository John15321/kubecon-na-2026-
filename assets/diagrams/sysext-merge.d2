vars: {
  d2-config: {
    pad: 24
    sketch: false
  }
}

classes: {
  yours: {style: {fill: "#FFFFFF"; stroke: "#12172B"; stroke-width: 3; stroke-dash: 6; font-color: "#12172B"; font-size: 28; bold: true; border-radius: 10}}
  flatcar: {style: {fill: "#09BAC8"; stroke: "#12172B"; stroke-width: 3; font-color: "#12172B"; font-size: 28; bold: true; border-radius: 10; shadow: true}}
  navy: {style: {fill: "#12172B"; stroke: "#12172B"; stroke-width: 3; font-color: "#FFFFFF"; font-size: 28; bold: true; border-radius: 10; shadow: true}}
  group: {style: {fill: "#F3F6FA"; stroke: "#12172B"; stroke-width: 3; font-color: "#12172B"; font-size: 30; bold: true; border-radius: 14}}
  arrow: {style: {stroke: "#12172B"; stroke-width: 4; font-color: "#12172B"; font-size: 24}}
}

direction: right

ext: "kubernetes.raw\nsquashfs in /etc/extensions" {class: yours; width: 420; height: 120}
base: "/usr\nFlatcar base image, read-only" {class: flatcar; width: 420; height: 120}

merge: "systemd-sysext\noverlay at boot" {class: navy; width: 280; height: 140}

usr: "/usr after merge, still read-only" {
  class: group
  grid-columns: 1
  grid-gap: 16
  k8s: "kubeadm, kubelet, kubectl\nfrom the extension" {class: yours; width: 440; height: 110}
  os: "systemd, containerd, docker\nfrom Flatcar" {class: flatcar; width: 440; height: 110}
}

ext -> merge {class: arrow}
base -> merge {class: arrow}
merge -> usr: "merged view" {class: arrow}
